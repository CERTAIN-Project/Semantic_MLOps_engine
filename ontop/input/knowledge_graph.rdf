</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap/experiments/1">
	<startedAtTime xmlns="http://www.w3.org/ns/prov#" rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-02-08 22:00:23.366+00</startedAtTime>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#Classification">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Techniques that assign input data to predefined categories or classes.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#HybridLearning">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Methods that combine different learning paradigms, such as hybrid neuronal systems, learning with knowledge, and conversational learning.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#Clustering">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Techniques that group similar data points together based on their features.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#SelfSupervisedLearning">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Techniques that generate their own labels from the input data to learn useful representations.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#LogicalReasoning">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Methods that use rules and principles for formal as well as interactive verification to identify patterns and logical structures and make logical deductions.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#CommunicationProcessing">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Communication processing encompasses AI system capabilities for transmitting and exchanging information, either unidirectionally without feedback or bidirectionally and omnidirectionally with feedback, enabling content generation and interactive communication in individual or group contexts.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#SemiSupervisedLearning">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Techniques that combine a small amount of labeled data with a large amount of unlabeled data during training.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#ConversationalLearning">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Methods that involve interactive learning through dialogue or feedback from users or other agents.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#Regression">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Techniques that predict continuous output values based on input data.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#Planning">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Approaches for autonomous and semi-autonomous planning procedures as well as plan recognition.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#DecisionMaking">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Approaches for selecting optimal actions under constraints or uncertainty.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#ActionControlProcessing">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Action control processing refers to AI system capabilities that enable movement and control through mechanical, electronic, or software components, allowing simulation and execution of human-like behaviors, object manipulation, and natural gestures with high precision.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#SymbolicAI">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Methods that use knowledge representation and logic-based reasoning to model knowledge and make inferences.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#MachineLearning">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Methods that learn patterns from data, including supervised, unsupervised, semi-supervised, self-supervised, and reinforcement learning.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#SensoryInputProcessing">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Internal sensory processing refers to AI system capabilities for interpreting data about its own internal states, such as position, orientation, pose, spatial configuration, or physical integrity, enabling self-monitoring and maintaining stability or optimal functioning.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#Search">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Techniques for exploring state spaces to find solutions.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#ProbabilisticReasoning">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Techniques that handle uncertainty and incomplete information using probabilistic models, such as Bayesian networks and Markov decision processes.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#SupervisedLearning">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Techniques that learn from labeled data to make predictions or classifications.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#HybridNeuronalSystems">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Methods that combine neural architectures with symbolic reasoning or other AI techniques.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#Optimization">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Methods for improving solutions iteratively, including heuristic and metaheuristic approaches.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#DimensionReduction">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Techniques that reduce the number of features in the data while preserving important information.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#TraditionalAI">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Algorithmic strategies for search, optimization, planning and decision making</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#UnsupervisedLearning">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Techniques that identify patterns and structures in unlabeled data.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#ReinforcementLearning">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Techniques that learn optimal actions through trial and error by receiving feedback in the form of rewards or penalties.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#KnowledgeProcessing">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Knowledge processing refers to AI system capabilities for handling different types of knowledge—factual, conceptual, procedural, and metacognitive—through activities such as recognizing patterns, classifying information, generating concepts, executing procedures, and applying reflective reasoning to solve problems and adapt to new situations.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#KnowledgeRepresentation">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Methods for structuring and organizing knowledge, including ontologies, semantic networks, and knowledge graphs.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#LearningWithKnowledge">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Techniques that integrate both symbolic or explicit knowledge representation and machine learning approaches.</definition>
</rdf:Description>

<rdf:Description rdf:about="https://w3id.org/aidoc-ap#NonProbabilisticReasoning">
	<definition xmlns="http://www.w3.org/2004/02/skos/core#">Techniques that do not rely on probabilistic models, such as qualitative procedures, rule-based approaches, reasoning with uncertainty as well as reasoning with belief functions.</definition>
</rdf:Description>

