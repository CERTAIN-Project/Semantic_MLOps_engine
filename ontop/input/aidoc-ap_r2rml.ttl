    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, document_id, filename, file_type, file_size,
                   link_to_artifacts, description,
                   to_timestamp(CASE WHEN creation_time > 10000000000 THEN creation_time / 1000.0 ELSE creation_time END) AS creation_ts,
                   unnest(COALESCE(tags::text[], ARRAY['']::text[])) as tag
            FROM visual_documentation
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/visual-doc/{run_id}/{document_id}" ;
        rr:class aidoc:VisualDocumentation ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "document_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:name ;
        rr:objectMap [ rr:column "filename" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:format ;
        rr:objectMap [ rr:column "file_type" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:contentSize ;
        rr:objectMap [ rr:column "file_size" ; rr:datatype xsd:integer ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:url ;
        rr:objectMap [ rr:column "link_to_artifacts" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:description ;
        rr:objectMap [ rr:column "description" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:keywords ;
        rr:objectMap [ rr:column "tag" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:created ;
        rr:objectMap [ rr:column "creation_ts" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link to run
    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/runs/{run_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# Risk -> Map from risks table
# =============================================================================

<#RiskTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [ rr:tableName "risks" ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/risk/{experiment_id}/{risk_id}" ;
        rr:class airo:Risk ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "risk_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:description ;
        rr:objectMap [ rr:column "risk_description" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:type ;
        rr:objectMap [ rr:column "risk_type" ; rr:datatype xsd:string ]
    ] ;

    # Link to experiment
    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/experiments/{experiment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# ChangeLog -> Map from change_logs table
# =============================================================================

<#ChangeLogTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [ rr:tableName "change_logs" ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/changelog/{run_id}" ;
        rr:class aidoc:ChangeLog ;
        rr:class prov:Activity ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/runs/{run_id}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Collect every ChangeRecord that belongs to this run
    rr:predicateObjectMap [
        rr:predicate aidoc:hasChangeRecord ;
        rr:objectMap [
            rr:parentTriplesMap <#ChangeRecordTriplesMap> ;
            rr:joinCondition [
                rr:child "run_id" ;
                rr:parent "run_id"
            ]
        ]
    ] .


# =============================================================================
# ChangeRecord -> Map from change_logs table
# =============================================================================

<#ChangeRecordTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, log_id, change_description, changed_by,
                   to_timestamp(CASE WHEN change_timestamp > 10000000000 THEN change_timestamp / 1000.0 ELSE change_timestamp END) AS change_ts
            FROM change_logs
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/changelog/{run_id}/{log_id}" ;
        rr:class aidoc:ChangeRecord ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "log_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:description ;
        rr:objectMap [ rr:column "change_description" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:wasAssociatedWith ;
        rr:objectMap [ rr:column "changed_by" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:endedAtTime ;
        rr:objectMap [ rr:column "change_ts" ; rr:datatype xsd:dateTime ]
    ] .


# =============================================================================
# PostMarketMonitoringActivity -> Map from drift_metrics and runtime_environment tables
# =============================================================================

<#PostMarketMonitoringActivityTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT dm.experiment_id, dm.deployment_id, dm.model_id,
                   dm.value as drift_value,
                   to_timestamp(CASE WHEN dm.timestamp > 10000000000 THEN dm.timestamp / 1000.0 ELSE dm.timestamp END) AS ts
            FROM drift_metrics dm
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/post-market-monitoring/{experiment_id}/{deployment_id}/{model_id}" ;
        rr:class aidoc:PostMarketMonitoringActivity ;
        rr:class aidoc:AIActivity ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [
            rr:template "Post-Market Monitoring for {model_id}" ;
            rr:termType rr:Literal
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:endedAtTime ;
        rr:objectMap [ rr:column "ts" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link to deployment
    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/deployments/{experiment_id}/{model_id}/{deployment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# PostMarketPerformanceEvaluationActivity -> Map from runtime_environment table
# =============================================================================

<#PostMarketPerformanceEvaluationActivityTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [ rr:tableName "runtime_environment" ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/post-market-performance/{experiment_id}/{deployment_id}/{model_id}" ;
        rr:class aidoc:PostMarketPerformanceEvaluationActivity ;
        rr:class aidoc:AIActivity ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [
            rr:template "Post-Market Performance Evaluation for {model_id}" ;
            rr:termType rr:Literal
        ]
    ] ;

    # Link to deployment
    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/deployments/{experiment_id}/{model_id}/{deployment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# HardwareComponent -> Map from resources table
# =============================================================================

<#HardwareComponentTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT run_id, model_id, key
            FROM resources
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/hardware/{run_id}/{model_id}/{key}" ;
        rr:class aidoc:HardwareComponent ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:name ;
        rr:objectMap [ rr:column "key" ; rr:datatype xsd:string ]
    ] ;

    # Link to model
    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# AILifecyclePhase -> Map from experiments table
# =============================================================================

<#AILifecyclePhaseTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT experiment_id, lifecycle_stage, description,
                   to_timestamp(CASE WHEN creation_time > 10000000000 THEN creation_time / 1000.0 ELSE creation_time END) AS creation_ts,
                   to_timestamp(CASE WHEN last_update_time > 10000000000 THEN last_update_time / 1000.0 ELSE last_update_time END) AS last_update_ts
            FROM experiments
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/lifecycle-phase/{experiment_id}" ;
        rr:class airo:AILifecyclePhase ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "experiment_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:name ;
        rr:objectMap [ rr:column "lifecycle_stage" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:description ;
        rr:objectMap [ rr:column "description" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:startedAtTime ;
        rr:objectMap [ rr:column "creation_ts" ; rr:datatype xsd:dateTime ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:endedAtTime ;
        rr:objectMap [ rr:column "last_update_ts" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link to experiment
    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/experiments/{experiment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


##############################################################################
# Phase 2 — Coverage extensions
##############################################################################


# =============================================================================
# AISystem -> Root node for each experiment
# =============================================================================

<#AISystemTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT experiment_id
            FROM experiments
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/ai-system/{experiment_id}" ;
        rr:class aidoc:AISystem ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "experiment_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:hasLifecycleStage ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/lifecycle-phase/{experiment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# Link AISystem -> AIModel via hasComponent (one AI model per run)
<#AISystemHasComponentTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT r.experiment_id, im.run_id, im.model_id
            FROM id_mapping im
            JOIN runs r ON im.run_id = r.run_id
            WHERE im.model_id IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/ai-system/{experiment_id}" ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:hasComponent ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# Link AISystem -> MLPipeline via hasAIActivity (one pipeline per run)
<#AISystemHasActivityTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT experiment_id, run_id
            FROM runs
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/ai-system/{experiment_id}" ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:hasAIActivity ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/ml-pipeline/{run_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# MLPipeline -> One per run
# =============================================================================

<#MLPipelineTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT run_id, experiment_id
            FROM runs
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/ml-pipeline/{run_id}" ;
        rr:class aidoc:MLPipeline ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "run_id" ; rr:datatype xsd:string ]
    ] ;

    # MLPipeline includes the ModelEngineering activity for its parent experiment
    rr:predicateObjectMap [
        rr:predicate dcterms:hasPart ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/experiments/{experiment_id}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # MLPipeline includes the matching DataPipeline
    rr:predicateObjectMap [
        rr:predicate dcterms:hasPart ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/data-pipeline/{run_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# Link MLPipeline -> ModelEvaluation via hasPart
<#MLPipelineHasEvaluationTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT im.run_id, im.model_id
            FROM id_mapping im
            WHERE im.model_id IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/ml-pipeline/{run_id}" ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:hasPart ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/model-evaluation/{run_id}/{model_id}" ;
            rr:termType rr:IRI
        ]
    ] .


<#MLPipelineHasDeploymentTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT im.run_id, md.experiment_id, md.model_id, md.deployment_id
            FROM id_mapping im
            JOIN model_deployed md
              ON im.model_id = md.model_id
             AND im.deployment_id = md.deployment_id
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/ml-pipeline/{run_id}" ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:hasPart ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/deployments/{experiment_id}/{model_id}/{deployment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# DataPipeline -> One per run (covers data lineage per ML run)
# =============================================================================

<#DataPipelineTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT run_id
            FROM data
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/data-pipeline/{run_id}" ;
        rr:class aidoc:DataPipeline ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "run_id" ; rr:datatype xsd:string ]
    ] .


# DataPipeline -> Dataset via producesDataset (one per data row)
<#DataPipelineProducesDatasetTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT run_id, data_id
            FROM data
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/data-pipeline/{run_id}" ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:producesDataset ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/data/{run_id}/{data_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# ModelVersioning -> Per (run, model)
# =============================================================================

<#ModelVersioningTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT md.run_id, md.model_id, md.model_version
            FROM model_deployed md
            WHERE md.model_version IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/model-versioning/{run_id}/{model_id}" ;
        rr:class aidoc:ModelVersioning ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "model_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:version ;
        rr:objectMap [ rr:column "model_version" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# SoftwareVersioning -> Per run (source code versioning)
# =============================================================================

<#SoftwareVersioningTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT run_id, git_commit_hash
            FROM runs_code
            WHERE git_commit_hash IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/software-versioning/{run_id}" ;
        rr:class aidoc:SoftwareVersioning ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "run_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:version ;
        rr:objectMap [ rr:column "git_commit_hash" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/runs/{run_id}/code" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# SoftwareComponent -> One per distinct framework
# =============================================================================

<#SoftwareComponentTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT framework
            FROM model_architecture
            WHERE framework IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/software-component/{framework}" ;
        rr:class aidoc:SoftwareComponent ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "framework" ; rr:datatype xsd:string ]
    ] .


# =============================================================================
# DataSheet -> One per dataset
# =============================================================================

<#DataSheetTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT run_id, data_id, data_type, data_source, data_format
            FROM data
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/datasheet/{run_id}/{data_id}" ;
        rr:class aidoc:DataSheet ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "data_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:type ;
        rr:objectMap [ rr:column "data_type" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:source ;
        rr:objectMap [ rr:column "data_source" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:format ;
        rr:objectMap [ rr:column "data_format" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/data/{run_id}/{data_id}" ;
            rr:termType rr:IRI
        ]
    ] .
