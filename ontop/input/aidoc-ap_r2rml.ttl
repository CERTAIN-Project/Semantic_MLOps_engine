# =============================================================================
# ModelEvaluation -> Map from model_metrics table
# =============================================================================

<#ModelEvaluationTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT run_id, model_id, stage,
                   to_timestamp(CASE WHEN timestamp > 10000000000 THEN timestamp / 1000.0 ELSE timestamp END) AS ts,
                   key, value
            FROM model_metrics
            WHERE stage = 'evaluation'
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/model-evaluation/{run_id}/{model_id}" ;
        rr:class aidoc:ModelEvaluation ;
        rr:class aidoc:AIActivity ;
