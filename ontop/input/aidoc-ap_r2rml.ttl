@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix aidoc: <https://w3id.org/aidoc-ap#> .
@prefix airo: <https://w3id.org/airo#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

# =============================================================================
# R2RML Mapping: Database Schema to AIDOC-AP Ontology
# =============================================================================
# This mapping transforms ML experiment tracking data into AIDOC-AP compliant
# RDF for AI system documentation per EU AI Act Annex IV requirements.
# =============================================================================


# =============================================================================
# EXPERIMENTS -> aidoc:ModelEngineering (mls:Experiment)
# =============================================================================
# Experiments represent ML experiments which map to ModelEngineering activities
# in the AIDOC-AP ontology (a subclass of mls:Experiment and MLPipeline).

<#ExperimentsTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT experiment_id, experiment_name, lifecycle_stage,
                   to_timestamp(CASE WHEN creation_time > 10000000000 THEN creation_time / 1000.0 ELSE creation_time END) AS creation_ts,
                   to_timestamp(CASE WHEN last_update_time > 10000000000 THEN last_update_time / 1000.0 ELSE last_update_time END) AS last_update_ts
            FROM experiments
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/experiments/{experiment_id}" ;
        rr:class aidoc:ModelEngineering ;
        rr:class mls:Experiment ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "experiment_name" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "experiment_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:hasLifecycleStage ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/lifecycle-stage/{lifecycle_stage}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:startedAtTime ;
        rr:objectMap [ rr:column "creation_ts" ; rr:datatype xsd:dateTime ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:endedAtTime ;
        rr:objectMap [ rr:column "last_update_ts" ; rr:datatype xsd:dateTime ]
    ] .


# =============================================================================
# EXPERIMENTS_TAGS -> Tags associated with experiments
# =============================================================================

<#ExperimentsTagsTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [ rr:tableName "experiments_tags" ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/experiments/{experiment_id}" ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:keywords ;
        rr:objectMap [
            rr:template "{key}:{value}" ;
            rr:termType rr:Literal
        ]
    ] .


# =============================================================================
# RUNS -> aidoc:AIActivity (prov:Activity)
# =============================================================================
# Runs represent individual training/evaluation runs as AI activities.

<#RunsTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, experiment_id, run_name, source_type, source_name,
                   user_id, status, source_version,
                   to_timestamp(CASE WHEN start_time > 10000000000 THEN start_time / 1000.0 ELSE start_time END) AS start_ts,
                   to_timestamp(CASE WHEN end_time > 10000000000 THEN end_time / 1000.0 ELSE end_time END) AS end_ts
            FROM runs
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/runs/{run_id}" ;
        rr:class aidoc:AIActivity ;
        rr:class prov:Activity ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "run_name" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "run_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:source ;
        rr:objectMap [ rr:column "source_name" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:version ;
        rr:objectMap [ rr:column "source_version" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:wasAssociatedWith ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/users/{user_id}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:status ;
        rr:objectMap [ rr:column "status" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:startedAtTime ;
        rr:objectMap [ rr:column "start_ts" ; rr:datatype xsd:dateTime ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:endedAtTime ;
        rr:objectMap [ rr:column "end_ts" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link run to its parent experiment
    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/experiments/{experiment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# RUNS_TAGS -> Tags associated with runs
# =============================================================================

<#RunsTagsTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [ rr:tableName "runs_tags" ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/runs/{run_id}" ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:keywords ;
        rr:objectMap [
            rr:template "{key}:{value}" ;
            rr:termType rr:Literal
        ]
    ] .


# =============================================================================
# RUNS_CODE -> aidoc:SoftwareImplementation
# =============================================================================
# Code snapshots associated with runs, mapping to SoftwareImplementation.

<#RunsCodeTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [ rr:tableName "runs_code" ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/runs/{run_id}/code" ;
        rr:class aidoc:SoftwareImplementation ;
        rr:class mls:Implementation ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "name" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:version ;
        rr:objectMap [ rr:column "git_commit_hash" ; rr:datatype xsd:string ]
    ] ;

    # Link to parent run
    rr:predicateObjectMap [
        rr:predicate prov:wasGeneratedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/runs/{run_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# RUNS_LOGS -> aidoc:Log
# =============================================================================
# Logs generated during runs, mapping to the Log class.

<#RunsLogsTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, log_id, log_type, log_message,
                   to_timestamp(CASE WHEN log_creation_time > 10000000000 THEN log_creation_time / 1000.0 ELSE log_creation_time END) AS log_creation_ts
            FROM runs_logs
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/runs/{run_id}/logs/{log_id}" ;
        rr:class aidoc:Log ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "log_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:type ;
        rr:objectMap [ rr:column "log_type" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:comment ;
        rr:objectMap [ rr:column "log_message" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:created ;
        rr:objectMap [ rr:column "log_creation_ts" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link to parent run
    rr:predicateObjectMap [
        rr:predicate prov:wasGeneratedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/runs/{run_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# DATA -> aidoc:Dataset
# =============================================================================
# Data entries mapping to the Dataset class in AIDOC-AP.

<#DataTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, data_id, data_stage, data_type, data_source,
                   data_version, data_location, data_size, data_format,
                   to_timestamp(CASE WHEN creation_time > 10000000000 THEN creation_time / 1000.0 ELSE creation_time END) AS creation_ts,
                   to_timestamp(CASE WHEN last_update_time > 10000000000 THEN last_update_time / 1000.0 ELSE last_update_time END) AS last_update_ts
            FROM data
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/data/{run_id}/{data_id}" ;
        rr:class aidoc:Dataset ;
        rr:class mls:Dataset ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "data_id" ; rr:datatype xsd:string ]
    ] ;

    # data_stage maps to the lifecycle stage of data usage
    rr:predicateObjectMap [
        rr:predicate aidoc:dataScope ;
        rr:objectMap [ rr:column "data_stage" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:type ;
        rr:objectMap [ rr:column "data_type" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:source ;
        rr:objectMap [ rr:column "data_source" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:version ;
        rr:objectMap [ rr:column "data_version" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:contentUrl ;
        rr:objectMap [ rr:column "data_location" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:contentSize ;
        rr:objectMap [ rr:column "data_size" ; rr:datatype xsd:double ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:format ;
        rr:objectMap [ rr:column "data_format" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:created ;
        rr:objectMap [ rr:column "creation_ts" ; rr:datatype xsd:dateTime ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:modified ;
        rr:objectMap [ rr:column "last_update_ts" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link to parent run
    rr:predicateObjectMap [
        rr:predicate prov:wasGeneratedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/runs/{run_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# DATA_SIGNATURES -> Schema information for datasets
# =============================================================================

<#DataSignaturesTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [ rr:tableName "data_signatures" ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/data/{run_id}/{data_id}" ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:dataCharacteristic ;
        rr:objectMap [ rr:column "signature" ; rr:datatype xsd:string ]
    ] .


# =============================================================================
# DATA_HYPERPARAMETERS -> Hyperparameters associated with data processing
# =============================================================================

<#DataHyperparametersTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [ rr:tableName "data_hyperparameters" ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/data/{run_id}/{data_id}/hyperparameter/{technique_parameter_name}" ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "technique_parameter_name" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "technique_name" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdf:value ;
        rr:objectMap [ rr:column "technique_parameter_value" ; rr:datatype xsd:string ]
    ] ;

    # Link to parent dataset
    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/data/{run_id}/{data_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# DATA_METRICS -> aidoc:PerformanceMetric (for data quality metrics)
# =============================================================================

<#DataMetricsTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, data_id, key, value, data_stage,
                   to_timestamp(CASE WHEN timestamp > 10000000000 THEN timestamp / 1000.0 ELSE timestamp END) AS ts
            FROM data_metrics
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/data/{run_id}/{data_id}/metric/{key}" ;
        rr:class dqv:Metric ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "key" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdf:value ;
        rr:objectMap [ rr:column "value" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:created ;
        rr:objectMap [ rr:column "ts" ; rr:datatype xsd:dateTime ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:dataScope ;
        rr:objectMap [ rr:column "data_stage" ; rr:datatype xsd:string ]
    ] ;

    # Link to parent dataset
    rr:predicateObjectMap [
        rr:predicate dqv:computedOn ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/data/{run_id}/{data_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# DATA_RESOURCES -> aidoc:ComputationalResource
# =============================================================================

<#DataResourcesTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, data_id, key, value, stage,
                   to_timestamp(CASE WHEN timestamp > 10000000000 THEN timestamp / 1000.0 ELSE timestamp END) AS ts
            FROM data_resources
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/data/{run_id}/{data_id}/resource/{key}" ;
        rr:class aidoc:ComputationalResource ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "key" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:resourceType ;
        rr:objectMap [ rr:column "stage" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdf:value ;
        rr:objectMap [ rr:column "value" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:created ;
        rr:objectMap [ rr:column "ts" ; rr:datatype xsd:dateTime ]
    ] .


# =============================================================================
# DATA_TECHNIQUES -> Data processing techniques used
# =============================================================================

<#DataTechniquesTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [ rr:tableName "data_techniques" ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/data/{run_id}/{data_id}" ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:dataCollectionMethod ;
        rr:objectMap [ rr:column "technique_name" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:dataScope ;
        rr:objectMap [ rr:column "data_technique_stage" ; rr:datatype xsd:string ]
    ] .


# =============================================================================
# MODEL_ARCHITECTURE -> aidoc:AIModel
# =============================================================================
# Model architecture information mapping to the AIModel class.

<#ModelArchitectureTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, model_id, architecture_name, activation_function,
                   loss_function, optimizer, layer_structure, framework,
                   input_shape, output_shape, number_of_layers,
                   number_of_total_parameters,
                   to_timestamp(CASE WHEN creation_time > 10000000000 THEN creation_time / 1000.0 ELSE creation_time END) AS creation_ts
            FROM model_architecture
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
        rr:class aidoc:AIModel ;
        rr:class mls:Model ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "model_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:hasArchitecture ;
        rr:objectMap [ rr:column "architecture_name" ; rr:datatype xsd:string ]
    ] ;

    # Map to AIMethod based on architecture
    rr:predicateObjectMap [
        rr:predicate aidoc:usesAIMethod ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/methods/{architecture_name}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Activation function as part of architecture description
    rr:predicateObjectMap [
        rr:predicate schema:applicationSubCategory ;
        rr:objectMap [ rr:column "activation_function" ; rr:datatype xsd:string ]
    ] ;

    # Loss function
    rr:predicateObjectMap [
        rr:predicate mls:hasObjective ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/objectives/{loss_function}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Optimizer
    rr:predicateObjectMap [
        rr:predicate mls:hasOptimizer ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/optimizers/{optimizer}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Layer structure (JSON)
    rr:predicateObjectMap [
        rr:predicate aidoc:hasArchitecture ;
        rr:objectMap [ rr:column "layer_structure" ; rr:datatype xsd:string ]
    ] ;

    # Framework used (maps to SoftwareDependency)
    rr:predicateObjectMap [
        rr:predicate aidoc:dependsOn ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/frameworks/{framework}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Input shape
    rr:predicateObjectMap [
        rr:predicate schema:encodingFormat ;
        rr:objectMap [ rr:column "input_shape" ; rr:datatype xsd:string ]
    ] ;

    # Output shape
    rr:predicateObjectMap [
        rr:predicate schema:additionalType ;
        rr:objectMap [ rr:column "output_shape" ; rr:datatype xsd:string ]
    ] ;

    # Number of layers
    rr:predicateObjectMap [
        rr:predicate schema:numberOfItems ;
        rr:objectMap [ rr:column "number_of_layers" ; rr:datatype xsd:integer ]
    ] ;

    # Total parameters
    rr:predicateObjectMap [
        rr:predicate mls:hasModelParameter ;
        rr:objectMap [ rr:column "number_of_total_parameters" ; rr:datatype xsd:integer ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:created ;
        rr:objectMap [ rr:column "creation_ts" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link to parent run
    rr:predicateObjectMap [
        rr:predicate prov:wasGeneratedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/runs/{run_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# MODEL_HYPERPARAMETERS -> mls:HyperParameter
# =============================================================================

<#ModelHyperparametersTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [ rr:tableName "model_hyperparameters" ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}/hyperparameter/{key}" ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "key" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdf:value ;
        rr:objectMap [ rr:column "value" ; rr:datatype xsd:string ]
    ] ;

    # Link to parent model
    rr:predicateObjectMap [
        rr:predicate mls:specifiedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# MODEL_METRICS -> aidoc:PerformanceMetric
# =============================================================================

<#ModelMetricsTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, model_id, key, value, step, stage,
                   to_timestamp(CASE WHEN timestamp > 10000000000 THEN timestamp / 1000.0 ELSE timestamp END) AS ts
            FROM model_metrics
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}/metric/{key}/step/{step}" ;
        rr:class aidoc:PerformanceMetric ;
        rr:class dqv:Metric ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "key" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdf:value ;
        rr:objectMap [ rr:column "value" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:step ;
        rr:objectMap [ rr:column "step" ; rr:datatype xsd:integer ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:dataScope ;
        rr:objectMap [ rr:column "stage" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:created ;
        rr:objectMap [ rr:column "ts" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link to parent model
    rr:predicateObjectMap [
        rr:predicate dqv:computedOn ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# LAST_MODEL_METRICS -> Latest performance metrics
# =============================================================================

<#LastModelMetricsTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, model_id, key, value, step, stage,
                   to_timestamp(CASE WHEN timestamp > 10000000000 THEN timestamp / 1000.0 ELSE timestamp END) AS ts
            FROM last_model_metrics
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}/latest-metric/{key}" ;
        rr:class aidoc:PerformanceMetric ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "key" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdf:value ;
        rr:objectMap [ rr:column "value" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:step ;
        rr:objectMap [ rr:column "step" ; rr:datatype xsd:integer ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:dataScope ;
        rr:objectMap [ rr:column "stage" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:created ;
        rr:objectMap [ rr:column "ts" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link to parent model with hasPerformanceMetric (for ModelEvaluation)
    rr:predicateObjectMap [
        rr:predicate dqv:computedOn ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# CHECKPOINTS -> Model checkpoints (snapshots during training)
# =============================================================================

<#CheckpointsTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, model_id, checkpoint_id, checkpoint_name,
                   checkpoint_location,
                   to_timestamp(CASE WHEN creation_time > 10000000000 THEN creation_time / 1000.0 ELSE creation_time END) AS creation_ts
            FROM checkpoints
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}/checkpoint/{checkpoint_id}" ;
        rr:class aidoc:AIModel ;
        rr:class prov:Entity ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "checkpoint_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "checkpoint_name" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:contentUrl ;
        rr:objectMap [ rr:column "checkpoint_location" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:created ;
        rr:objectMap [ rr:column "creation_ts" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link to parent model as derivation
    rr:predicateObjectMap [
        rr:predicate prov:wasDerivedFrom ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# WEIGHT_DISTRIBUTION -> Model weight statistics
# =============================================================================

<#WeightDistributionTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, model_id, layer_name, step, stage,
                   to_timestamp(CASE WHEN timestamp > 10000000000 THEN timestamp / 1000.0 ELSE timestamp END) AS ts
            FROM weight_distribution
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}/weights/{layer_name}/step/{step}" ;
        rr:class aidoc:PerformanceMetric ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "layer_name" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:step ;
        rr:objectMap [ rr:column "step" ; rr:datatype xsd:integer ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:dataScope ;
        rr:objectMap [ rr:column "stage" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:created ;
        rr:objectMap [ rr:column "ts" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link to parent model
    rr:predicateObjectMap [
        rr:predicate dqv:computedOn ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# EXAMPLES -> Training/validation/test examples with predictions
# =============================================================================

<#ExamplesTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, model_id, md5(input) AS input_hash, step, stage,
                   input, prediction, ground_truth,
                   to_timestamp(CASE WHEN timestamp > 10000000000 THEN timestamp / 1000.0 ELSE timestamp END) AS ts
            FROM examples
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}/example/{step}/{stage}/{input_hash}" ;
        rr:class prov:Entity ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:input ;
        rr:objectMap [ rr:column "input" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:result ;
        rr:objectMap [ rr:column "prediction" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:expectedResult ;
        rr:objectMap [ rr:column "ground_truth" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:step ;
        rr:objectMap [ rr:column "step" ; rr:datatype xsd:integer ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:dataScope ;
        rr:objectMap [ rr:column "stage" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:created ;
        rr:objectMap [ rr:column "ts" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link to model
    rr:predicateObjectMap [
        rr:predicate prov:wasGeneratedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# RESOURCES -> aidoc:ComputationalResource
# =============================================================================

<#ResourcesTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, model_id, key, value, step, stage,
                   to_timestamp(CASE WHEN timestamp > 10000000000 THEN timestamp / 1000.0 ELSE timestamp END) AS ts
            FROM resources
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}/resource/{key}/step/{step}" ;
        rr:class aidoc:ComputationalResource ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "key" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdf:value ;
        rr:objectMap [ rr:column "value" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:step ;
        rr:objectMap [ rr:column "step" ; rr:datatype xsd:integer ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:resourceType ;
        rr:objectMap [ rr:column "stage" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:created ;
        rr:objectMap [ rr:column "ts" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link to model
    rr:predicateObjectMap [
        rr:predicate prov:wasUsedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Link to the hardware component backing this resource
    rr:predicateObjectMap [
        rr:predicate aidoc:requiresHardware ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/hardware/{run_id}/{model_id}/{key}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# MODEL_DEPLOYED -> aidoc:Deployment
# =============================================================================
# Deployed models mapping to the Deployment activity class.

<#ModelDeployedTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT experiment_id, deployment_id, run_id, model_id, user_id,
                   model_version, endpoint, model_format, size, description,
                   current_stage, location, status,
                   to_timestamp(CASE WHEN deployed_time > 10000000000 THEN deployed_time / 1000.0 ELSE deployed_time END) AS deployed_ts
            FROM model_deployed
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/deployments/{experiment_id}/{model_id}/{deployment_id}" ;
        rr:class aidoc:Deployment ;
        rr:class aidoc:AIActivity ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "deployment_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:startedAtTime ;
        rr:objectMap [ rr:column "deployed_ts" ; rr:datatype xsd:dateTime ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:version ;
        rr:objectMap [ rr:column "model_version" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:url ;
        rr:objectMap [ rr:column "endpoint" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:format ;
        rr:objectMap [ rr:column "model_format" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:contentSize ;
        rr:objectMap [ rr:column "size" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:comment ;
        rr:objectMap [ rr:column "description" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate prov:wasAssociatedWith ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/users/{user_id}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:hasLifecycleStage ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/lifecycle-stage/{current_stage}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:contentUrl ;
        rr:objectMap [ rr:column "location" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:status ;
        rr:objectMap [ rr:column "status" ; rr:datatype xsd:string ]
    ] ;

    # Link to parent experiment
    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/experiments/{experiment_id}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Link to deployed model (if run_id exists)
    rr:predicateObjectMap [
        rr:predicate prov:used ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# DRIFT_METRICS -> aidoc:PostMarketMonitoringActivity metrics
# =============================================================================

<#DriftMetricsTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT experiment_id, deployment_id, model_id,
                   CAST(CASE WHEN timestamp > 10000000000 THEN timestamp / 1000 ELSE timestamp END AS bigint) AS ts_epoch,
                   to_timestamp(CASE WHEN timestamp > 10000000000 THEN timestamp / 1000.0 ELSE timestamp END) AS ts_dt,
                   value
            FROM drift_metrics
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/deployments/{experiment_id}/{model_id}/{deployment_id}/drift/{ts_epoch}" ;
        rr:class aidoc:PerformanceMetric ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:constant "Drift Metric" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdf:value ;
        rr:objectMap [ rr:column "value" ; rr:datatype xsd:integer ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:created ;
        rr:objectMap [ rr:column "ts_dt" ; rr:datatype xsd:dateTime ]
    ] ;

    # Link to deployment
    rr:predicateObjectMap [
        rr:predicate dqv:computedOn ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/deployments/{experiment_id}/{model_id}/{deployment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# MONITOR_LOGS -> aidoc:Log (post-deployment monitoring)
# =============================================================================

<#MonitorLogsTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [ rr:tableName "monitor_logs" ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/deployments/{experiment_id}/{model_id}/{deployment_id}/log/{log_id}" ;
        rr:class aidoc:Log ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "log_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:comment ;
        rr:objectMap [ rr:column "message" ; rr:datatype xsd:string ]
    ] ;

    # Link to deployment
    rr:predicateObjectMap [
        rr:predicate prov:wasGeneratedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/deployments/{experiment_id}/{model_id}/{deployment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# RUNTIME_ENVIRONMENT -> aidoc:ComputationalResource
# =============================================================================

<#RuntimeEnvironmentTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [ rr:tableName "runtime_environment" ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/deployments/{experiment_id}/{model_id}/{deployment_id}/runtime" ;
        rr:class aidoc:ComputationalResource ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "server_name" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:resourceConfiguration ;
        rr:objectMap [ rr:column "performance" ; rr:datatype xsd:string ]
    ] ;

    # Link to deployment
    rr:predicateObjectMap [
        rr:predicate prov:wasUsedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/deployments/{experiment_id}/{model_id}/{deployment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# ID_MAPPING -> Cross-reference linking
# =============================================================================
# This table provides cross-reference IDs; we use it to create additional links.

<#IdMappingRunToModelTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT im.run_id, im.model_id, im.data_id, im.deployment_id, r.experiment_id
            FROM id_mapping im
            JOIN runs r ON im.run_id = r.run_id
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/runs/{run_id}" ;
    ] ;

    # Link run to model
    rr:predicateObjectMap [
        rr:predicate prov:generated ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Link run to data
    rr:predicateObjectMap [
        rr:predicate prov:used ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/data/{run_id}/{data_id}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Link run to deployment
    rr:predicateObjectMap [
        rr:predicate prov:generated ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/deployments/{experiment_id}/{model_id}/{deployment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# USERS (implicit from user_id references) -> aidoc:AIResearcher
# =============================================================================
# Create user entities from runs table user_id

<#UsersTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT user_id
            FROM runs
            WHERE user_id IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/users/{user_id}" ;
        rr:class aidoc:AIResearcher ;
        rr:class foaf:Person ;
        rr:class prov:Agent ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "user_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate foaf:accountName ;
        rr:objectMap [ rr:column "user_id" ; rr:datatype xsd:string ]
    ] .


# =============================================================================
# FRAMEWORKS (implicit from model_architecture) -> aidoc:SoftwareDependency
# =============================================================================

<#FrameworksTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT framework
            FROM model_architecture
            WHERE framework IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/frameworks/{framework}" ;
        rr:class aidoc:SoftwareDependency ;
        rr:class mls:Software ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "framework" ; rr:datatype xsd:string ]
    ] .


##############################################################################
# New
##############################################################################


# =============================================================================
# AITask -> Map from experiments.description
# =============================================================================

<#AITaskTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT experiment_id, description
            FROM experiments
            WHERE description IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/tasks/{experiment_id}" ;
        rr:class aidoc:AITask ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "description" ; rr:datatype xsd:string ]
    ] .


# =============================================================================
# AIMethod -> Map from model_architecture (name + activation)
# =============================================================================

<#AIMethodTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT architecture_name, activation_function, loss_function
            FROM model_architecture
            WHERE architecture_name IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/methods/{architecture_name}" ;
        rr:class aidoc:AIMethod ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [
            rr:template "{architecture_name}_{activation_function}_{loss_function}" ;
            rr:termType rr:Literal
        ]
    ] .


# =============================================================================
# AIProvider -> Map from ai_actors.ai_provider
# =============================================================================

<#AIProviderTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT ai_actors_id, experiment_id, ai_provider, organization
            FROM ai_actors
            WHERE ai_provider IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/providers/{ai_provider}" ;
        rr:class aidoc:AIProvider ;
        rr:class foaf:Organization ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [ rr:column "ai_provider" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:organizationName ;
        rr:objectMap [ rr:column "organization" ; rr:datatype xsd:string ]
    ] ;

    # Link provider to experiment
    rr:predicateObjectMap [
        rr:predicate dcterms:relation ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/experiments/{experiment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# AIDeployer -> Map from ai_actors.ai_deployer
# =============================================================================

<#AIDeployerTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT ai_actors_id, experiment_id, ai_deployer, organization
            FROM ai_actors
            WHERE ai_deployer IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/deployers/{ai_deployer}" ;
        rr:class aidoc:AIDeployer ;
        rr:class foaf:Organization ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [ rr:column "ai_deployer" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:organizationName ;
        rr:objectMap [ rr:column "organization" ; rr:datatype xsd:string ]
    ] ;

    # Link deployer to experiment
    rr:predicateObjectMap [
        rr:predicate dcterms:relation ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/experiments/{experiment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# Auditor -> Map from ai_actors.auditor
# =============================================================================

<#AuditorTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT DISTINCT ai_actors_id, experiment_id, auditor, organization
            FROM ai_actors
            WHERE auditor IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/auditors/{auditor}" ;
        rr:class aidoc:Auditor ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [ rr:column "auditor" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:organizationName ;
        rr:objectMap [ rr:column "organization" ; rr:datatype xsd:string ]
    ] ;

    # Link auditor to experiment
    rr:predicateObjectMap [
        rr:predicate dcterms:relation ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/experiments/{experiment_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# DataTraining -> Map from data table where data_stage = 'training'
# =============================================================================

<#DataTrainingTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, data_id, data_stage, data_type, data_source,
                   data_version, data_location, data_size, data_format,
                   creation_time, last_update_time
            FROM data
            WHERE LOWER(data_stage) = 'training' OR LOWER(data_stage) LIKE '%train%'
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/data-activities/training/{run_id}/{data_id}" ;
        rr:class aidoc:DataTraining ;
        rr:class aidoc:AIActivity ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [
            rr:template "Training Data Activity for {data_id}" ;
            rr:termType rr:Literal
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "data_id" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate aidoc:dataScope ;
        rr:objectMap [ rr:column "data_stage" ; rr:datatype xsd:string ]
    ] ;

    # Link to the actual dataset
    rr:predicateObjectMap [
        rr:predicate prov:used ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/data/{run_id}/{data_id}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Link to the run
    rr:predicateObjectMap [
        rr:predicate prov:wasInfluencedBy ;
        rr:objectMap [
            rr:template "https://w3id.org/aidoc-ap/runs/{run_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# =============================================================================
# DataValidation -> Map from data table where data_stage = 'validation'
# =============================================================================

<#DataValidationTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, data_id, data_stage, data_type, data_source,
                   data_version, data_location, data_size, data_format,
                   creation_time, last_update_time
            FROM data
            WHERE LOWER(data_stage) = 'validation' OR LOWER(data_stage) LIKE '%valid%'
        """
    ] ;

    rr:subjectMap [
