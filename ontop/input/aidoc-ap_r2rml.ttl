# =============================================================================
# DataWrangling -> Map from data table where data_stage = 'wrangling'/'preprocessing'
# =============================================================================

<#DataWranglingTriplesMap>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:sqlQuery """
            SELECT run_id, data_id, data_stage, data_type, data_source,
                   data_version, data_location, data_size, data_format,
                   creation_time, last_update_time, data_acquisition_method
            FROM data
            WHERE LOWER(data_stage) IN ('wrangling', 'preprocessing', 'preparation')
               OR LOWER(data_stage) LIKE '%wrangl%'
               OR LOWER(data_stage) LIKE '%preprocess%'
        """
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/aidoc-ap/data-activities/wrangling/{run_id}/{data_id}" ;
        rr:class aidoc:DataWrangling ;
