# Copy to .env (git-ignored) and fill in real secrets. Never commit real keys.
# test_docker/test_it_complete.py loads ./.env without overriding variables that are already exported.

# --- LLM text generation (scenario UI: "LLM natural text") ---
OPENAI_API_KEY=sk-your-openai-key-here
# Read by the Synthetic-Data-Generation-Component; leave empty for api.openai.com
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# --- MinIO / S3 data sink (DATASPACE_SOURCE=s3://<bucket>/<prefix>) ---
MINIO_ENDPOINT=api.minio.private.novelcore.org:443
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_SECURE=True

# --- Phase 1 selection (used when DATASPACE_SOURCE is empty) ---
# ui (default): open the scenario UI and design the batch in the browser
# offline: regenerate the fixed deterministic batch 7, no UI and no LLM call
IT_PHASE1_MODE=ui
# IT_UI_HOST=   # default: 127.0.0.1, or 0.0.0.0 automatically inside Docker
IT_UI_PORT=8769
IT_UI_TIMEOUT_SECONDS=1800

# --- Token / proxy settings ---
# NOTE: no Python code in this repo or in Synthetic-Data-Generation-Component reads these yet.
# To send LLM calls to this endpoint today, put the same URL in OPENAI_BASE_URL above.
OPENAI_TARGET_API_URL=https://llm-serving.eu-dev.novelcore.org/v1
CERTAIN_TOKEN_MODE=balanced
CERTAIN_USE_HEADROOM=1
HEADROOM_PROXY_URL=http://127.0.0.1:8787/v1
CERTAIN_LOG_TOKEN_USAGE=1
CERTAIN_HEADROOM_PREFLIGHT_COMPRESSION=1
CERTAIN_HEADROOM_TARGET_RATIO=0.35
CERTAIN_HEADROOM_PREFLIGHT_MODE=lossy_inline
CERTAIN_SCENARIO_PROMPT_TEMPLATE=baseline
